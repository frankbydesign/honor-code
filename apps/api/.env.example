# Copy to apps/api/.env and fill in. Never commit .env.

# The one URL the app knows itself by. Plain http is accepted only for
# localhost. The Google redirect URI is derived from this:
# <APP_BASE_URL>/api/auth/google/callback
APP_BASE_URL=http://localhost:8000

# Optional. Where the browser lands after login; default "/". scripts/run.sh
# and scripts/dev.sh each export the right value themselves, so leave this
# unset unless you start uvicorn by hand against the Angular dev server:
# POST_LOGIN_REDIRECT=http://localhost:4200/

# Optional. Leave unset to use apps/api/data/honor-code.db (created on first
# run). Any sqlite+aiosqlite:/// URL works.
# DATABASE_URL=

# At least 32 bytes. Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# A Fernet key. Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# From Google Cloud Console, the OAuth client for this app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma- or whitespace-separated. Only these Google accounts can sign in.
ALLOWED_EMAILS=you@example.com
