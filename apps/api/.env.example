# Copy to apps/api/.env and fill in. Never commit .env.

# The one URL the app knows itself by. Plain http is accepted only for
# localhost. The Google redirect URI is derived from this:
# <APP_BASE_URL>/api/auth/google/callback
APP_BASE_URL=http://localhost:8000

# Optional. Where the browser lands after login; default "/". scripts/run.sh
# and scripts/dev.sh each export the right value themselves, so leave this
# unset unless you start uvicorn by hand against the Angular dev server:
# POST_LOGIN_REDIRECT=http://localhost:4200/

# Optional. Leave unset to use apps/api/data/honor-code.db (created on first
# run). Any sqlite+aiosqlite:/// URL works.
# DATABASE_URL=

# At least 32 bytes. Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# A Fernet key. Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# From Google Cloud Console, the OAuth client for this app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma- or whitespace-separated. Only these Google accounts can sign in.
ALLOWED_EMAILS=you@example.com

# --- Phase 1: Fathom sync and commitment extraction ---------------------
# All optional at startup. Without the two keys the app still runs, and the
# sync status line names what is missing.

# Anthropic API key used only by Honor Code. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Fathom: User Settings -> API Access. Reaches only meetings you recorded or
# that were shared with you.
FATHOM_API_KEY=

# Model for extraction. Change in one line to compare.
# EXTRACTION_MODEL=claude-sonnet-5-5
# EXTRACTION_TIMEOUT_SECONDS=120

# The first sync reaches this many days back; later syncs pick up from the
# last one. Interval is how often the running app syncs on its own.
# FATHOM_BACKFILL_DAYS=14
# FATHOM_SYNC_INTERVAL_MINUTES=30

# Meeting dates (and "tomorrow" in a commitment) are resolved in this zone.
# LOCAL_TIMEZONE=America/Los_Angeles

# Set to false to turn off the automatic sync (Sync now still works).
# SYNC_ENABLED=true
